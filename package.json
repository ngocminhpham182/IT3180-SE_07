{
  "name": "bluemoon-fe-sprint1-assigned",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node --test tests/*.test.mjs && vitest run",
